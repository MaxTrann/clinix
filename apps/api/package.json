{
  "name": "clinix-api",
  "version": "0.0.1",
  "description": "CLINIX — API (NestJS)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "lint:fix": "oxlint --type-aware --fix src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:int": "vitest run --config ./vitest.config.integration.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration:run": "nest build && node dist/database/migrate.js up",
    "migration:revert": "nest build && node dist/database/migrate.js down",
    "migration:status": "nest build && node dist/database/migrate.js status",
    "test:p7": "vitest run --config ./vitest.config.p7.ts",
    "seed:catalog": "nest build && node dist/database/seeds/seed.js catalog",
    "seed:dev-accounts": "nest build && node dist/database/seeds/seed.js dev-accounts",
    "seed:first-admin": "nest build && node dist/database/seeds/seed.js first-admin",
    "seed:config-dev": "nest build && node dist/database/seeds/seed.js config-dev"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "2.11.0",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.13",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
