# Sao chép thành `.env` rồi điền giá trị. KHÔNG commit file `.env`.
# Mọi giá trị dưới đây chỉ là mẫu cho môi trường dev.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=clinix
MYSQL_USER=clinix
MYSQL_PASSWORD=change_me_app
# Giờ nghiệp vụ là giờ Việt Nam (+07:00). TZ được truyền vào API và container db; DB_TIMEZONE cấu hình driver,
# còn `SET time_zone` áp dụng cho từng kết nối MySQL. Xem docs/DEV_SETUP.md.
TZ=Asia/Ho_Chi_Minh

# --- API (NestJS) ---
API_PORT=3000
DB_HOST=db
DB_PORT=3306
DB_TIMEZONE=+07:00
# true = API tự chạy migration chưa áp dụng mỗi lần khởi động (tiện cho dev); mặc định trong mã là false.
# Staging/production: đặt false và chạy `npm run migration:run` có chủ đích (xem docs/TECH_DEBT.md)
DB_MIGRATIONS_RUN=true
# Khoá ký token đăng nhập (task A3). BẮT BUỘC: mỗi khoá ≥ 32 ký tự và hai khoá phải KHÁC nhau, nếu không API không khởi động.
# Hai dòng dưới chỉ là chỗ giữ chỗ GIẢ để chạy thử; hãy thay bằng chuỗi ngẫu nhiên của riêng bạn (cách sinh: docs/DEV_SETUP.md mục 4).
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
# Cookie chứa refresh token có thuộc tính Secure. Mặc định true. Chỉ được đặt false khi chạy cục bộ với NODE_ENV=development
# (mặc định của API); ở staging/production đặt false thì API từ chối khởi động. Staging có người truy cập qua mạng phải dùng HTTPS.
COOKIE_SECURE=true
# Origin của web (scheme://host[:port], không có đường dẫn hay dấu / cuối). /auth/refresh và /auth/logout chỉ nhận request có
# header Origin đúng bằng giá trị này, nên staging phải đổi thành địa chỉ web thật (ví dụ https://staging.example.com).
WEB_ORIGIN=http://localhost:5173

# --- Test tích hợp / e2e của API (`npm run test:int`, `npm run test:e2e` chạy trên máy host) ---
# Nối MySQL của compose qua cổng đã publish. Mật khẩu mặc định lấy từ MYSQL_ROOT_PASSWORD (không cần khai báo lại).
# DB test (clinix_test, clinix_ref_test, clinix_migration_test) bị XÓA và tạo lại mỗi lần chạy; tên phải kết thúc bằng `_test`.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_NAME=clinix_test

# --- Web (Vite) ---
VITE_API_URL=http://localhost:3000

# --- Gửi email OTP qua Gmail SMTP (task P4; cách tạo Gmail riêng và mật khẩu ứng dụng: docs/DEV_SETUP.md mục 4.2) ---
# Dev/test: có thể BỎ TRỐNG cả ba SMTP_HOST, SMTP_USER, SMTP_PASS; API vẫn chạy nhưng mọi chức năng gửi email báo lỗi.
# Đặt nửa vời (ví dụ có SMTP_USER mà thiếu SMTP_PASS) thì API KHÔNG khởi động.
# Staging/production (NODE_ENV=staging hoặc production): BẮT BUỘC đặt đủ ba biến, thiếu thì API không khởi động.
# Mật khẩu ứng dụng thật chỉ điền vào file .env của bạn: KHÔNG commit, KHÔNG dán vào chat, issue, PR hay prompt AI.
# Với Gmail: SMTP_HOST=smtp.gmail.com
SMTP_HOST=
# 465 = TLS ngay từ đầu (khuyến nghị); cổng khác (ví dụ 587) bắt buộc STARTTLS. Không có chế độ gửi không mã hoá.
SMTP_PORT=465
# Địa chỉ Gmail riêng của dự án (N8). Mặc định cũng là địa chỉ người gửi.
SMTP_USER=
# Mật khẩu ứng dụng (App Password) 16 ký tự, gõ LIỀN, không dấu cách.
SMTP_PASS=
# Tên hiển thị của người gửi
MAIL_FROM_NAME=CLINIX
# Để trống = dùng SMTP_USER
MAIL_FROM_ADDRESS=
# Địa chỉ hỗ trợ in trong thư (N8, G4); để trống thì thư bỏ dòng hỗ trợ
MAIL_SUPPORT_ADDRESS=

# --- Dịch vụ tích hợp (sandbox) ---
# [cần điền] cổng thanh toán sandbox / khóa AI — chốt khi làm module tương ứng
