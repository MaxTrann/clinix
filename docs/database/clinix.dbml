// CLINIX - Database Diagram (ERD) - bản 2
// Sinh từ Class Diagram + các quyết định của nhóm ngày 16/10/2026
// Dịch vụ tách 3 khái niệm: nhom_dich_vu (điều hướng) - chuyen_khoa (lĩnh vực bác sĩ) - dich_vu_kham (thứ đặt lịch, có giá/cọc/hoàn hủy)
// DBMS mục tiêu: MySQL 8.0.17+ (utf8mb4); CHECK thật sự được thực thi từ 8.0.16, hàm JSON_SCHEMA_VALID trong chk_cau_hinh_nhac_lich cần 8.0.17
// Các ràng buộc CHECK và cột sinh được khai báo đầy đủ trong clinix_mysql.sql
// 18/10/2026: lịch hoạt động theo thứ của chi nhánh (chi_nhanh_lich_hoat_dong), yêu cầu thay đổi chi nhánh (yeu_cau_thay_doi_chi_nhanh + _lich_hen), email_thong_bao => 43 bảng, 26 enum
// 18/10/2026 (đợt 2): đồng bộ cấu hình hệ thống — bỏ cau_hinh_he_thong.so_ngay_dat_truoc_toi_da, bac_si_uu_tien_id, thoi_luong_khung_gio_mac_dinh; so_lich_hen_toi_da_moi_tk đổi thành so_lich_hen_toi_da_moi_ho_so (đếm theo hồ sơ đi khám); thêm nhac_lich_hen (mỗi cặp lịch hẹn + mốc nhắc); nhat_ky_hanh_dong thêm CapNhatCauHinh / cau_hinh_he_thong; lich_hen có khóa ngoại kép tới ho_so_nguoi_than => 44 bảng, 26 enum
// 19/10/2026: phụ phí bác sĩ tra theo CHỨC DANH 7 mức (chuc_danh_enum, bac_si.chuc_danh, phu_phi_bac_si.chuc_danh) thay vì hoc_vi 5 mức; hoc_vi giữ cho điểm xếp hạng AI; phu_phi_bac_si thêm ap_dung (quy tắc tắt bị loại khỏi phép tính) => 44 bảng, 27 enum
// 19/10/2026 (đợt đồng bộ UC 53/70): thêm XuLyNapViChuaCong vào enum nhật ký; không thêm bảng hoặc enum mới.
// 19/10/2026 (quy tắc đổi chi nhánh bác sĩ): chỉ sửa ghi chú bac_si.chi_nhanh_id và mô tả quy tắc 13; không đổi bảng, cột, enum, constraint.
// 20/10/2026 (cách chia khung giờ): chỉ sửa Note của khung_gio và mô tả quy tắc 39/mục (b) của clinix_quy_tac_nghiep_vu.md: các khung giờ nối liền nhau theo thời lượng khám, phần dư cuối khoảng nhận khám không sinh khung giờ; không đổi bảng, cột, enum, constraint.
// 20/10/2026 (truy vết Lễ tân thu tiền mặt tại quầy): giao_dich_thanh_toan thêm nguoi_thu_id (khóa ngoại tới le_tan.tai_khoan_id) và CHECK chk_gd_tien_mat_nguoi_thu; không thêm bảng hoặc enum. Chuyển đổi từ DB cũ: mục 9 của clinix_quy_tac_nghiep_vu.md.
// 19/10/2026 (lịch hoạt động chi nhánh hai khoảng nhận khám): chi_nhanh_lich_hoat_dong bỏ gio_mo_cua/gio_dong_cua, thay bằng gio_bat_dau_sang, gio_ket_thuc_sang, gio_bat_dau_chieu, gio_ket_thuc_chieu; ràng buộc (chk_lich_hoat_dong_khoang/_khong_chong/_ngay) khai báo trong clinix_mysql.sql; 44 bảng, 27 enum.
// 26/10/2026 (module auth, task P3): ma_xac_thuc thêm 3 cột dữ liệu lần đăng ký (ho_ten_dang_ky, so_dien_thoai_dang_ky, mat_khau_bam_dang_ky) và chk_ma_xac_thuc_du_lieu_dang_ky; da_gui_luc/thu_hoi_luc dùng cả cho OTP; tài khoản Bệnh nhân chưa xác minh giữ 24 giờ; phien_dang_nhap chốt tên và thời hạn (bỏ [đề xuất]); vi_noi_bo tạo cùng benh_nhan khi xác minh OTP; chỉ đổi cột/CHECK/ghi chú của ma_xac_thuc, không thêm bảng hoặc enum => 44 bảng, 27 enum, 38 CHECK. Chuyển đổi từ DB cũ: mục 10 của clinix_quy_tac_nghiep_vu.md.

Project clinix {
  database_type: 'MySQL'
}

// ===================== ENUM =====================

Enum trang_thai_hoat_dong_enum {
  DangHoatDong
  NgungHoatDong
}

// Trạng thái RIÊNG của tài khoản (khác trang_thai_hoat_dong_enum dùng cho chuyen_khoa).
// ChoKichHoat chỉ dành cho nhân sự (BacSi, LeTan, QuanTriVien) vừa được tạo: chưa có mật khẩu, chưa đăng nhập được.
Enum trang_thai_tai_khoan_enum {
  ChoKichHoat
  DangHoatDong
  NgungHoatDong
}

Enum loai_tai_khoan_enum {
  BenhNhan
  BacSi
  LeTan
  QuanTriVien
}

// Học vị 5 mức: dùng cho công thức điểm xếp hạng AI (quy đổi số năm), KHÔNG dùng để tra phụ phí
Enum hoc_vi_enum {
  BS
  ThS
  TS
  PGS
  GS
}

// Chức danh 7 mức (mã trùng DoctorTitleCode của prototype): CHỈ dùng tra phụ phí bác sĩ và hiển thị, KHÔNG đưa vào công thức AI. Ánh xạ sang hoc_vi: xem bac_si
Enum chuc_danh_enum {
  BS
  BS_CKI
  BS_CKII
  ThS_BS
  TS_BS
  PGS_TS_BS
  GS_TS_BS
}

Enum pham_vi_quan_tri_enum {
  ToanHeThong
  ChiNhanh
}

Enum ca_lam_viec_enum {
  CaSang [note: 'Dùng khoảng nhận khám buổi sáng của chi nhánh']
  CaChieu [note: 'Dùng khoảng nhận khám buổi chiều của chi nhánh']
  CaToi [note: 'Lịch hoạt động chi nhánh không có khoảng tối nên service không phân công, nhận xin nghỉ hay nhận đăng ký chờ cho CaToi; giữ hay bỏ khỏi enum: nhóm quyết, xem mục 8 của clinix_quy_tac_nghiep_vu.md']
}

Enum hinh_thuc_nghi_enum {
  CaNgay
  TheoCa
}

Enum trang_thai_khung_gio_enum {
  ConTrong
  DaDat
  DangGiuCho
  HetHan
}

Enum trang_thai_lich_hen_enum {
  ChoThanhToan
  DaXacNhan
  DaTiepDon
  HoanThanh
  DaHuy
  DaDoiLich
  VangMat
}

Enum trang_thai_yeu_cau_enum {
  ChoDuyet
  DaDuyet
  TuChoi
}

Enum trang_thai_muc_cho_enum {
  DangCho
  DaMoi
  DaChapNhan
  DaTuChoi
  HetHan
}

Enum loai_giao_dich_enum {
  NapVi
  ThanhToanLichHen
}

Enum phuong_thuc_enum {
  Vi
  VNPay
  MoMo
  TienMatTaiQuay
}

Enum trang_thai_giao_dich_enum {
  KhoiTao
  DangXuLy
  ThanhCong
  ThatBai
  HetHan
}

Enum trang_thai_doi_soat_enum {
  KhongCan
  ChoDoiSoat
  DaDoiSoat
}

Enum loai_giao_dich_vi_enum {
  Nap
  ThanhToan
  HoanTien
  Rut
}

Enum ket_qua_enum {
  ThanhCong
  ThatBai
}

Enum hanh_dong_nhay_cam_enum {
  DoiQuyen
  OverrideLichHen
  HoanTienDacBiet
  DoiChiNhanhBacSi
