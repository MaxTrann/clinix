# Sao chép thành `.env` rồi điền giá trị. KHÔNG commit file `.env`.
# Mọi giá trị dưới đây chỉ là mẫu cho môi trường dev.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=clinix
MYSQL_USER=clinix
MYSQL_PASSWORD=change_me_app

# --- API (NestJS) ---
API_PORT=3000
DB_HOST=db
DB_PORT=3306
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
# CORS: origin của web
WEB_ORIGIN=http://localhost:5173

# --- Web (Vite) ---
VITE_API_URL=http://localhost:3000

# --- Dịch vụ tích hợp (sandbox) ---
# [cần điền] SMTP / cổng thanh toán sandbox / khóa AI — chốt khi làm module tương ứng