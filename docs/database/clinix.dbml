  BanNhap
  DaXuatBan
  LuuTruAn
}

// Lý do một lịch hẹn bị ảnh hưởng bởi yêu cầu thay đổi chi nhánh (bảng yeu_cau_thay_doi_chi_nhanh_lich_hen)
Enum ly_do_anh_huong_enum {
  NgayNghi
  NgoaiGioHoatDong
  BoDichVu
}

// Kết quả gửi email (bảng email_thong_bao: email của thông báo; bảng nhac_lich_hen: email nhắc lịch hẹn)
Enum trang_thai_gui_email_enum {
  ChoGui
  DaGui
  ThatBai
}

Enum loai_xac_thuc_enum {
  DangKy
  QuenMatKhau
  KichHoatNhanSu
}

Enum moi_quan_he_enum {
  Cha
  Me
  Vo
  Chong
  Con
  AnhChiEm
  OngBa
  Khac
}

// ===================== CỤM 1: TÀI KHOẢN & HỒ SƠ =====================

Table tai_khoan {
  tai_khoan_id bigint [pk, increment]
  ho_ten varchar(100) [not null]
  ngay_sinh date [note: 'Có thể để trống: lúc đăng ký chỉ nhập họ tên, email, SĐT, mật khẩu']
  gioi_tinh varchar(10) [note: 'Có thể để trống (như ngày sinh)']
  so_dien_thoai varchar(20) [not null]
  anh_dai_dien varchar(255)
  dia_chi varchar(255)
  email varchar(255) [not null, unique]
  mat_khau_bam varchar(255) [note: 'NULL chỉ khi trang_thai = ChoKichHoat (nhân sự chưa tự đặt mật khẩu qua liên kết kích hoạt; Quản trị viên không đặt, không nhìn thấy, không gửi mật khẩu). DangHoatDong bắt buộc có mật khẩu (chk_tai_khoan_mat_khau)']
  trang_thai trang_thai_tai_khoan_enum [not null, default: 'DangHoatDong', note: 'Bệnh nhân đăng ký vào thẳng DangHoatDong (chưa xác minh email thì chưa được đặt lịch). Nhân sự tạo mới ở ChoKichHoat, chưa đăng nhập được, chỉ chuyển sang DangHoatDong khi tự đặt mật khẩu qua liên kết kích hoạt; KHÔNG chuyển bằng thao tác Mở khóa']
  da_xac_minh_email boolean [not null, default: false, note: 'false thì không được đặt lịch. Đăng ký tạo tài khoản ngay với false; OTP đúng thì đặt true. Tài khoản Bệnh nhân chưa xác minh bị xóa sau 24 giờ kể từ thoi_diem_tao (không gia hạn khi gửi lại OTP; không bao giờ xóa tài khoản nhân sự). Nhân sự: đặt true khi kích hoạt thành công vì liên kết gửi tới đúng email này [đề xuất]']
  so_lan_dang_nhap_sai int [not null, default: 0, note: 'Số lần đăng nhập sai liên tiếp, về 0 khi đăng nhập đúng. Email không tồn tại thì không đếm']
  khoa_dang_nhap_den datetime [note: 'Còn ở tương lai thì đang bị khóa đăng nhập (5 lần sai liên tiếp, khóa 15 phút); NULL = không khóa']
  loai_tai_khoan loai_tai_khoan_enum [not null, note: 'Cột đề xuất thêm để biết nhanh loại tài khoản, không cần JOIN 4 bảng con']
  thoi_diem_tao datetime [not null, default: `now()`, note: 'Thời điểm đăng ký tài khoản']

  Note: 'CHECK trong SQL: (1) ChoKichHoat thì mat_khau_bam NULL, DangHoatDong thì mat_khau_bam NOT NULL, NgungHoatDong không ràng buộc (chk_tai_khoan_mat_khau); (2) tài khoản BenhNhan không bao giờ ở ChoKichHoat (chk_tai_khoan_cho_kich_hoat_nhan_su). Kích hoạt: nhân sự mở liên kết (ma_xac_thuc loai KichHoatNhanSu) và đặt mật khẩu; mat_khau_bam, trang_thai = DangHoatDong và da_dung_luc của liên kết được ghi trong CÙNG 1 giao dịch. Không còn mật khẩu tạm và cờ bắt buộc đổi mật khẩu.'
}

Table benh_nhan {
  tai_khoan_id bigint [pk, ref: - tai_khoan.tai_khoan_id]
  khoa_dat_lich_do_no_show boolean [not null, default: false, note: 'Quản trị viên mở khóa thủ công nên là trạng thái độc lập']
  so_lan_no_show int [not null, default: 0]

  Note: 'Cố ý KHÔNG có chi_nhanh_id. Quản trị viên Chi nhánh chỉ XEM Bệnh nhân có ít nhất 1 lich_hen (mọi trạng thái) với lich_hen.chi_nhanh_id = chi nhánh được gán (snapshot lúc đặt); lọc qua lich_hen.benh_nhan_id + lich_hen.chi_nhanh_id, không thêm cột chi nhánh vào bảng này.'
}

Table bac_si {
  tai_khoan_id bigint [pk, ref: - tai_khoan.tai_khoan_id]
  mo_ta_chuyen_mon text [note: 'Tùy chọn, được để trống: biểu mẫu Tạo tài khoản nhân sự không bắt buộc nhập']
  so_nam_kinh_nghiem int [not null, default: 0, note: '>= 0 (chk_bac_si_kinh_nghiem) [đề xuất]']
  hoc_vi hoc_vi_enum [not null, note: 'Học vị 5 mức: dùng cho điểm xếp hạng AI (kinh_nghiem_norm = min(số năm kinh nghiệm + năm quy đổi học vị, 20) / 20), KHÔNG dùng tra phụ phí. Phải tương thích với chuc_danh (chk_bac_si_chuc_danh_hoc_vi)']
  chuc_danh chuc_danh_enum [not null, note: 'Chức danh 7 mức: CHỈ dùng tra phụ phí (phu_phi_bac_si.chuc_danh) và hiển thị. Tương thích với hoc_vi: BS, BS_CKI, BS_CKII <-> BS (BS_CKI và BS_CKII <-> BS là [đề xuất], chưa chốt bác sĩ CKI/CKII có thể mang học vị ThS không); ThS_BS <-> ThS; TS_BS <-> TS; PGS_TS_BS <-> PGS; GS_TS_BS <-> GS. ENUM NOT NULL tự lấy giá trị đầu (BS) nếu bỏ trống: service phải bắt buộc nhập tường minh (test GAP)']
  chuyen_khoa_id bigint [not null, ref: > chuyen_khoa.chuyen_khoa_id]
  chi_nhanh_id bigint [not null, ref: > chi_nhanh.chi_nhanh_id, note: 'Chỉ Quản trị viên Toàn hệ thống đổi trực tiếp trong hồ sơ bác sĩ; chỉ khi bác sĩ không còn lịch hẹn đang hoạt động ở chi nhánh hiện tại và không còn lich_lam_viec có ngay từ hôm nay trở đi ở chi nhánh hiện tại (kiểm tra ở service ngay trước khi lưu; lịch hẹn và ca đã qua giữ để truy vết); ghi nhật ký DoiChiNhanhBacSi']
  dich_vu_kham_id bigint [not null, ref: > dich_vu_kham.dich_vu_kham_id]

  Note: 'Hồ sơ bác sĩ được tạo cùng tai_khoan trong CÙNG 1 giao dịch khi tạo tài khoản Bác sĩ (kể cả khi ChoKichHoat): thiếu chuc_danh, hoc_vi, so_nam_kinh_nghiem, chuyen_khoa_id, chi_nhanh_id hoặc dich_vu_kham_id thì không tạo tài khoản. 1 bác sĩ thuộc 1 chuyên khoa và nhận 1 dịch vụ khám chính; chuyên khoa và dịch vụ là hai chiều phân loại độc lập. Giá khám = giá mặc định của dịch vụ + phụ phí (bảng phu_phi_bac_si, tra theo chuc_danh và so_nam_kinh_nghiem). Ràng buộc (kiểm tra ở service): cặp (chi_nhanh_id, dich_vu_kham_id) phải có trong chi_nhanh_dich_vu_kham.'
}

Table le_tan {
  tai_khoan_id bigint [pk, ref: - tai_khoan.tai_khoan_id]
  chi_nhanh_id bigint [not null, ref: > chi_nhanh.chi_nhanh_id, note: 'Lễ tân luôn được gán đúng 1 chi nhánh']
}

Table quan_tri_vien {
  tai_khoan_id bigint [pk, ref: - tai_khoan.tai_khoan_id]
  pham_vi_quan_tri pham_vi_quan_tri_enum [not null]
  chi_nhanh_id bigint [ref: >? chi_nhanh.chi_nhanh_id]

  Note: 'Ràng buộc: phạm vi Chi nhánh thì bắt buộc có chi_nhanh_id; phạm vi Toàn hệ thống thì để trống.'
}

Table ho_so_nguoi_than {
  ho_so_nguoi_than_id bigint [pk, increment]
  benh_nhan_id bigint [not null, ref: > benh_nhan.tai_khoan_id]
  ho_ten varchar(100) [not null]
  ngay_sinh date [not null]
  gioi_tinh varchar(10) [not null]
  dia_chi varchar(255)
  moi_quan_he moi_quan_he_enum [not null, note: '[đề xuất] danh sách giá trị; Khac cho quan hệ không có trong danh sách']
  so_dien_thoai varchar(20)
  trang_thai_hieu_luc boolean [not null, default: true, note: 'Không xóa thật, chỉ đổi trạng thái']

  indexes {
    (ho_so_nguoi_than_id, benh_nhan_id) [unique, note: 'Để lich_hen tham chiếu bằng khóa ngoại kép: DB chặn gắn lịch hẹn với hồ sơ người thân của bệnh nhân khác']
  }
}

Table ma_xac_thuc {
  ma_xac_thuc_id bigint [pk, increment]
  tai_khoan_id bigint [not null, ref: > tai_khoan.tai_khoan_id]
  loai loai_xac_thuc_enum [not null]
  ma_bam varchar(255) [not null, note: 'Lưu bản băm, không lưu bản rõ: OTP (DangKy, QuenMatKhau) = HMAC-SHA-256 với khóa bí mật riêng, dữ liệu băm gồm tai_khoan_id, loai, ma_xac_thuc_id và mã (không dùng SHA-256 trơn); liên kết kích hoạt = băm của token']
  het_han_luc datetime [not null]
  da_dung_luc datetime [note: 'Để trống = chưa dùng; liên kết kích hoạt chỉ dùng 1 lần']
  da_gui_luc datetime [note: 'Thời điểm dịch vụ email xác nhận đã gửi THÀNH CÔNG; để trống = mới tạo hoặc gửi lỗi, chưa có hiệu lực. KichHoatNhanSu: liên kết chưa gửi thì chưa hợp lệ. OTP (DangKy, QuenMatKhau): mã chưa gửi thành công không xác minh được và không thay thế mã cũ; chỉ mã mới nhất ĐÃ GỬI THÀNH CÔNG mới thay thế mã cũ']
  thu_hoi_luc datetime [note: 'Thời điểm mã bị vô hiệu; để trống = chưa thu hồi. KichHoatNhanSu: gửi lại thành công thì liên kết cũ bị thu hồi; liên kết mới gửi thất bại thì chính nó bị thu hồi. OTP: bị thu hồi khi mã mới gửi thành công, khi gửi lỗi (chính hàng mới), khi nhập sai đủ 5 lần, hoặc khi đặt lại mật khẩu thành công trên tài khoản chưa xác minh']
  kich_hoat_dang_hieu_luc bigint [unique, note: 'Cột sinh STORED + UNIQUE: bằng tai_khoan_id khi loai = KichHoatNhanSu, da_gui_luc có giá trị, chưa thu hồi, chưa dùng; NULL trong mọi trường hợp khác. Nhờ đó mỗi tài khoản chỉ có tối đa 1 liên kết kích hoạt hợp lệ tại một thời điểm (hết hạn het_han_luc kiểm tra ở service)']
  so_lan_nhap_sai int [not null, default: 0, note: 'Số lần nhập sai của MÃ NÀY (OTP: đủ 5 lần thì thu hồi mã)']
  tao_luc datetime [not null, default: `now()`, note: 'Dùng đếm giới hạn gửi lại OTP: cách mã trước ≥ 60 giây, tối đa 5 mã/giờ theo (tai_khoan_id, loai); tính cả hàng gửi lỗi']
  ho_ten_dang_ky varchar(100) [note: 'Chỉ loai = DangKy: họ tên của LẦN ĐĂNG KÝ gắn với mã này; chỉ được ghi vào tai_khoan khi chính mã này được xác minh đúng. NULL khi không phải DangKy, hoặc sau khi mã đã dùng/bị thu hồi do đặt lại mật khẩu (ba cột dữ liệu đăng ký cùng NULL hoặc cùng có giá trị: chk_ma_xac_thuc_du_lieu_dang_ky)']
  so_dien_thoai_dang_ky varchar(20) [note: 'Số điện thoại của lần đăng ký này (xem ho_ten_dang_ky)']
  mat_khau_bam_dang_ky varchar(255) [note: 'Bản băm Argon2id của mật khẩu của lần đăng ký này, không bao giờ lưu bản rõ (xem ho_ten_dang_ky)']

  indexes {
    (tai_khoan_id, loai, het_han_luc)
    (tai_khoan_id, loai, tao_luc)
  }

  Note: 'Vòng đời liên kết KichHoatNhanSu (token chỉ lưu bản băm; URL chứa ma_xac_thuc_id + token, so token với ma_bam). Hợp lệ khi da_gui_luc có giá trị, thu_hoi_luc rỗng, da_dung_luc rỗng và het_han_luc > bây giờ (thời hạn [đề xuất: 24 giờ], chưa chốt). (1) Tạo tài khoản hoặc Gửi lại: INSERT liên kết mới với da_gui_luc rỗng (chưa hợp lệ), rồi gửi email. (2) Gửi thành công, trong 1 giao dịch: thu hồi liên kết cũ chưa dùng (thu_hoi_luc = bây giờ) rồi đặt da_gui_luc = bây giờ cho liên kết mới => chỉ liên kết mới hợp lệ. (3) Gửi thất bại: đặt thu_hoi_luc cho CHÍNH liên kết mới, không đụng liên kết cũ => liên kết cũ còn hạn vẫn hợp lệ. (4) Kích hoạt, trong 1 giao dịch: đặt da_dung_luc, mat_khau_bam, trang_thai = DangHoatDong (và da_xac_minh_email = true [đề xuất]). Giới hạn tần suất gửi lại liên kết: [cần điền].'
}

// Phiên đăng nhập (tên bảng và cột đã chốt, Q10): refresh token ngẫu nhiên 256 bit chỉ lưu bản băm; xoay tại chỗ mỗi lần làm mới; đăng xuất hoặc dùng lại token cũ thì đặt thu_hoi_luc.
Table phien_dang_nhap {
  phien_dang_nhap_id bigint [pk, increment]
  tai_khoan_id bigint [not null, ref: > tai_khoan.tai_khoan_id]
  refresh_token_bam varchar(255) [not null, unique, note: 'Lưu SHA-256 của refresh token (chuỗi ngẫu nhiên 256 bit, dạng sid.ngẫu nhiên.chữ ký), không lưu bản rõ; thay bằng băm mới mỗi lần làm mới (xoay tại chỗ)']
  tao_luc datetime [not null, default: `now()`, note: 'Thời điểm đăng nhập; mốc tính trần tuyệt đối 8 giờ']
  het_han_luc datetime [not null, note: 'Hết hạn trượt: lúc đăng nhập = tao_luc + 30 phút (không hoạt động); mỗi lần làm mới = min(bây giờ + 30 phút, tao_luc + 8 giờ). Quá het_han_luc hoặc quá trần 8 giờ kể từ tao_luc thì refresh bị từ chối']
  thu_hoi_luc datetime [note: 'Để trống = còn hiệu lực. Ghi thời điểm khi: đăng xuất, phát hiện dùng lại refresh token cũ, đặt lại hoặc đổi mật khẩu (các phiên khác), khóa tài khoản']

  indexes {
    (tai_khoan_id, thu_hoi_luc)
  }
}

// ===================== CỤM 2: DANH MỤC =====================

Table chi_nhanh {
  chi_nhanh_id bigint [pk, increment]
  ten varchar(100) [not null]
  dia_chi varchar(255) [not null]
  toa_do_lat decimal(10,7)
  toa_do_lng decimal(10,7)

  Note: 'Ngày và giờ hoạt động KHÔNG nằm ở đây mà ở bảng con chi_nhanh_lich_hoat_dong (mỗi thứ trong tuần 1 dòng); 2 cột gio_mo_cua/gio_dong_cua chung cho mọi ngày của bản trước (17/10/2026) đã bỏ để chỉ còn 1 nguồn dữ liệu. Chi nhánh mới phải có đủ 7 dòng lịch hoạt động (kiểm tra ở service); chưa có dòng của một thứ thì thứ đó coi là CHƯA KHAI BÁO và không nhận phân công, không nhận đặt lịch.'
}

Table chi_nhanh_lich_hoat_dong {
  chi_nhanh_id bigint [ref: > chi_nhanh.chi_nhanh_id]
  thu_trong_tuan tinyint [note: '1 = Thứ Hai ... 7 = Chủ nhật (ISO 8601), khớp WEEKDAY(ngay) + 1 của MySQL. Ràng buộc: 1 đến 7']
  hoat_dong boolean [not null, note: 'true = chi nhánh nhận khám vào thứ này (có ít nhất một khoảng nhận khám đầy đủ); false = nghỉ cả ngày (cả bốn cột giờ để trống). chk_lich_hoat_dong_ngay giữ cột này khớp với các khoảng nên đây không phải nguồn chỉnh sửa độc lập']
  gio_bat_dau_sang time [note: 'Khoảng nhận khám buổi sáng (ca CaSang), cùng gio_ket_thuc_sang: cả hai để trống = không có buổi sáng; có thì bắt đầu < kết thúc']
  gio_ket_thuc_sang time [note: 'Xem gio_bat_dau_sang. Phải <= gio_bat_dau_chieu khi có cả hai khoảng (không chồng nhau; chạm nhau là hợp lệ); không qua đêm (trong 00:00:00 đến 23:59:59)']
  gio_bat_dau_chieu time [note: 'Khoảng nhận khám buổi chiều (ca CaChieu), cùng gio_ket_thuc_chieu: cả hai để trống = không có buổi chiều; có thì bắt đầu < kết thúc']
  gio_ket_thuc_chieu time [note: 'Xem gio_bat_dau_chieu. Không qua đêm (trong 00:00:00 đến 23:59:59)']

  indexes {
    (chi_nhanh_id, thu_trong_tuan) [pk]
  }

  Note: 'Lịch NHẬN KHÁM hằng tuần của chi nhánh, mỗi thứ tối đa 1 dòng và tối đa 2 khoảng nhận khám: buổi sáng (gio_bat_dau_sang đến gio_ket_thuc_sang, dùng cho ca CaSang) và buổi chiều (gio_bat_dau_chieu đến gio_ket_thuc_chieu, dùng cho ca CaChieu); mỗi khoảng có thể không tồn tại (cả hai giờ để trống). Ngày nghỉ: hoat_dong = false và cả bốn giờ để trống. Ngày hoạt động: có ít nhất một khoảng đầy đủ, bắt đầu < kết thúc, hai khoảng không chồng nhau (kết thúc sáng <= bắt đầu chiều), không có ca qua đêm (chk_lich_hoat_dong_khoang, chk_lich_hoat_dong_khong_chong, chk_lich_hoat_dong_ngay). Giờ mở và giờ đóng tổng quát để hiển thị KHÔNG lưu riêng mà suy ra từ các khoảng (giờ bắt đầu sớm nhất, giờ kết thúc muộn nhất; truy vấn mẫu cuối file). Giờ lưu ở đây là giờ nhận khám: khung giờ đặt khám phải nằm trọn trong một khoảng. Giờ mở cửa tiếp đón (nếu sớm hơn giờ nhận khám) chưa có chỗ lưu [cần điền: 07:30 trong giao diện minh họa là giờ bắt đầu nhận khám hay chỉ giờ mở cửa tiếp đón]. Chưa có lịch nghỉ lễ (chưa có quyết định). Là trạng thái ĐANG ÁP DỤNG: thay đổi ảnh hưởng lịch hẹn chỉ được ghi vào đây khi đến hieu_luc_tu của yeu_cau_thay_doi_chi_nhanh. DB không chặn phân công/đặt lịch ngoài khoảng nhận khám hoặc vào ca không tồn tại: service kiểm tra (truy vấn mẫu cuối file).'
}

Table chuyen_khoa {
  chuyen_khoa_id bigint [pk, increment]
  ten varchar(100) [not null, note: 'Lĩnh vực chuyên môn của bác sĩ. Ví dụ: Cơ Xương Khớp, Thần kinh, Tiêu hóa, Nội tổng quát, Y học gia đình, Tâm thần']
  mo_ta text
  anh_dai_dien varchar(255) [note: 'Đường dẫn ảnh minh họa hiển thị trên thẻ chuyên khoa; có thể để trống']
  trang_thai_hoat_dong trang_thai_hoat_dong_enum [not null, default: 'DangHoatDong']
}

Table nhom_dich_vu {
  nhom_dich_vu_id bigint [pk, increment]
  ten varchar(100) [not null, unique, note: 'Ví dụ: Khám chuyên khoa, Khám tổng quát, Khám từ xa, Xét nghiệm y học, Sức khỏe tinh thần, Khám nha khoa']
  thu_tu_hien_thi int [not null, default: 0, note: '[đề xuất] Thứ tự hiển thị trên màn điều hướng']

  Note: 'Chỉ để phân loại và điều hướng, không dùng trực tiếp để đặt lịch hay tính giá.'
}

Table dich_vu_kham {
  dich_vu_kham_id bigint [pk, increment]
  nhom_dich_vu_id bigint [not null, ref: > nhom_dich_vu.nhom_dich_vu_id]
  ten varchar(100) [not null]
  thoi_luong int [not null, note: 'phút']
  gia_mac_dinh decimal(12,2) [not null]
  muc_dat_coc decimal(12,2) [not null, default: 0, note: 'Mức cọc cố định theo dịch vụ; 0 = không đặt cọc']
}

Table moc_hoan_tien {
  moc_hoan_tien_id bigint [pk, increment]
  dich_vu_kham_id bigint [not null, ref: > dich_vu_kham.dich_vu_kham_id]
  so_gio_truoc_toi_thieu int [not null, note: 'Hủy trước giờ hẹn ít nhất bấy nhiêu giờ thì áp dụng tỷ lệ này']
  ty_le_hoan tinyint [not null, note: 'Ràng buộc: 0 đến 100. Ví dụ [đề xuất]: 24 giờ -> 100, 2 giờ -> 50, 0 giờ -> 0']

  indexes {
    (dich_vu_kham_id, so_gio_truoc_toi_thieu) [unique]
  }
}

Table chi_nhanh_dich_vu_kham {
  chi_nhanh_id bigint [ref: > chi_nhanh.chi_nhanh_id]
  dich_vu_kham_id bigint [ref: > dich_vu_kham.dich_vu_kham_id]

  indexes {
    (chi_nhanh_id, dich_vu_kham_id) [pk]
  }

  Note: 'Dịch vụ của bác sĩ phải nằm trong danh sách này của chi nhánh bác sĩ công tác. Lúc đặt lịch, cặp (chi nhánh, dịch vụ) cũng phải có ở đây. Bỏ một dịch vụ khỏi danh sách đang có lịch hẹn Chờ thanh toán/Đã xác nhận thì phải đi qua yeu_cau_thay_doi_chi_nhanh.'
}

// Yêu cầu thay đổi chi nhánh ảnh hưởng lịch hẹn đã đặt (giờ/ngày hoạt động, dịch vụ khả dụng). Thay đổi KHÔNG ảnh hưởng lịch hẹn nào thì áp dụng ngay, không cần dòng này.
Table yeu_cau_thay_doi_chi_nhanh {
  yeu_cau_thay_doi_chi_nhanh_id bigint [pk, increment]
  chi_nhanh_id bigint [not null, ref: > chi_nhanh.chi_nhanh_id]
  nguoi_de_xuat_id bigint [not null, ref: > quan_tri_vien.tai_khoan_id, note: 'Người gửi yêu cầu (Quản trị viên Chi nhánh của chi nhánh đó, hoặc Toàn hệ thống). Phạm vi kiểm tra ở service']
  noi_dung_truoc json [not null, note: 'Bản chụp phần SẮP BỊ ĐỔI tại lúc đề xuất, cùng khóa với noi_dung_sau. Ví dụ: {"lich_hoat_dong":[{"thu_trong_tuan":6,"hoat_dong":true,"gio_bat_dau_sang":"07:30:00","gio_ket_thuc_sang":"12:00:00","gio_bat_dau_chieu":null,"gio_ket_thuc_chieu":null}],"dich_vu_kham_ids":[1,2,3]}']
  noi_dung_sau json [not null, note: 'Phần đề xuất, chỉ gồm các khóa lich_hoat_dong và/hoặc dich_vu_kham_ids muốn đổi (lich_hoat_dong: mỗi phần tử là TOÀN BỘ dòng của một thứ muốn đổi, luôn đủ 6 khóa thu_trong_tuan, hoat_dong, gio_bat_dau_sang, gio_ket_thuc_sang, gio_bat_dau_chieu, gio_ket_thuc_chieu, khoảng không tồn tại ghi null tường minh, khi áp dụng thì thay cả dòng của thứ đó; dich_vu_kham_ids: danh sách MỚI đầy đủ). KHÔNG áp dụng vào chi_nhanh_lich_hoat_dong / chi_nhanh_dich_vu_kham khi mới gửi hoặc mới duyệt, chỉ áp dụng ở hieu_luc_tu']
  trang_thai trang_thai_yeu_cau_enum [not null, default: 'ChoDuyet']
  thoi_diem_tao datetime [not null, default: `now()`]
  nguoi_duyet_id bigint [ref: >? quan_tri_vien.tai_khoan_id, note: 'Phải là Quản trị viên Toàn hệ thống (kiểm tra ở service). Chưa chốt: Quản trị viên Toàn hệ thống có được tự duyệt đề xuất của chính mình không [cần điền]; DB chưa chặn']
  thoi_diem_duyet datetime [note: 'Thời điểm duyệt hoặc từ chối']
  ly_do_tu_choi varchar(255) [note: 'Bắt buộc khi TuChoi [đề xuất], để trống ở trạng thái khác']
  so_ngay_bao_truoc int [note: 'Chỉ khi DaDuyet: bản chụp cau_hinh_he_thong.so_ngay_bao_truoc_doi_gio_lam tại lúc duyệt (ngày), để cấu hình đổi sau này không làm sai lịch sử']
  hieu_luc_tu datetime [note: 'Chỉ khi DaDuyet: thời điểm thay đổi bắt đầu có hiệu lực. Ràng buộc: >= thoi_diem_duyet + so_ngay_bao_truoc ngày, nên thông báo luôn đi trước. Ai chọn thời điểm này (hệ thống tự tính hay người duyệt nhập) [cần điền]']
  ap_dung_luc datetime [note: 'Thời điểm hệ thống thực sự ghi thay đổi vào bảng đang áp dụng; để trống = chưa áp dụng. Không thể sớm hơn hieu_luc_tu']

  indexes {
    (chi_nhanh_id, trang_thai)
    (trang_thai, hieu_luc_tu)
  }

  Note: 'Thứ tự nghiệp vụ: đề xuất (ChoDuyet) -> kiểm tra lịch hẹn bị ảnh hưởng -> duyệt hoặc từ chối -> (duyệt) tạo thông báo + email cho bệnh nhân bị ảnh hưởng, ghi danh sách vào yeu_cau_thay_doi_chi_nhanh_lich_hen -> đến hieu_luc_tu mới áp dụng (ap_dung_luc). Chưa quy định: cho phép nhiều yêu cầu ChoDuyet cùng 1 chi nhánh hay không [cần điền], người gửi có được rút yêu cầu không [cần điền], cách xử lý lịch hẹn bị ảnh hưởng sau khi áp dụng [cần điền].'
}

Table yeu_cau_thay_doi_chi_nhanh_lich_hen {
  yeu_cau_thay_doi_chi_nhanh_id bigint [ref: > yeu_cau_thay_doi_chi_nhanh.yeu_cau_thay_doi_chi_nhanh_id]
  lich_hen_id bigint [ref: > lich_hen.lich_hen_id]
  ly_do_anh_huong ly_do_anh_huong_enum [not null]

  indexes {
    (yeu_cau_thay_doi_chi_nhanh_id, lich_hen_id) [pk]
    (lich_hen_id)
  }

  Note: 'Danh sách lịch hẹn (Chờ thanh toán, Đã xác nhận) bị ảnh hưởng, chụp lúc duyệt, tính với thời điểm có hiệu lực. Là cơ sở tạo thông báo cho đúng bệnh nhân đặt lịch (lich_hen.benh_nhan_id). Chưa lưu cách xử lý từng lịch hẹn vì chưa có quyết định [cần điền].'
}

Table phu_phi_bac_si {
  phu_phi_bac_si_id bigint [pk, increment]
  chuc_danh chuc_danh_enum [not null, note: 'Mã chức danh 7 mức (KHÁC hoc_vi 5 mức dùng cho AI); khớp bac_si.chuc_danh']
  so_nam_kinh_nghiem_tu int [not null, default: 0, note: 'Áp dụng từ mốc số năm này trở lên; >= 0']
  phu_phi decimal(12,2) [not null, note: 'Giá trị [cần điền]; các mức ở prototype chỉ là dữ liệu demo, CHƯA phải quyết định; >= 0']
  ap_dung boolean [not null, default: true, note: 'false = quy tắc đang TẮT, bị loại khỏi phép tính phụ phí nhưng giữ lại để bật lại; mặc định true [đề xuất]']

  indexes {
    (chuc_danh, so_nam_kinh_nghiem_tu) [unique, note: 'Mỗi (chức danh, mốc năm) tối đa 1 dòng, KỂ CẢ dòng đã tắt: muốn đổi giá thì sửa dòng đó (hoặc xóa rồi tạo lại), không tạo dòng thứ hai']
  }

  Note: 'Quy tắc phụ phí do Quản trị viên Toàn hệ thống cấu hình, KHÔNG có dòng nào tạo sẵn. Phụ phí hiện hành của bác sĩ = phu_phi của dòng có chuc_danh = chức danh của bác sĩ, ap_dung = true, so_nam_kinh_nghiem_tu <= số năm kinh nghiệm của bác sĩ, lấy dòng có so_nam_kinh_nghiem_tu LỚN NHẤT; không có dòng nào thì bằng 0 (truy vấn mẫu cuối clinix_mysql.sql). Dòng ap_dung = false bị loại khỏi phép tính: tắt mốc cao thì bác sĩ rơi xuống mốc thấp hơn đang áp dụng, không về 0 (ý nghĩa này cần nhóm xác nhận [cần điền]). Giá chốt lưu ở lich_hen.gia_snapshot lúc đặt; sửa, tắt, xóa quy tắc hay đổi chức danh, học vị, số năm kinh nghiệm của bác sĩ sau đó KHÔNG đổi lịch đã đặt.'
}

Table thong_tin_phong_kham {
  id tinyint [pk, note: 'Luôn bằng 1, bảng chỉ có 1 dòng']
  ten_thuong_hieu varchar(100)
  dia_chi_tru_so varchar(255)
  duong_day_nong varchar(20)
  email varchar(255)
}

Table cau_hinh_he_thong {
  id tinyint [pk, note: 'Luôn bằng 1, bảng chỉ có 1 dòng']
  thoi_gian_giu_cho int [not null, default: 15, note: 'phút; [đề xuất] 15']
  thoi_diem_nhac_lich json [not null, default: `json_array(72,24,2)`, note: 'Mảng các mốc nhắc, mỗi phần tử là số giờ NGUYÊN DƯƠNG trước giờ hẹn, không trùng nhau (CHECK chk_cau_hinh_nhac_lich); [đề xuất] 72, 24, 2; mảng rỗng được DB chấp nhận (nghĩa là không nhắc, chưa chốt có cho tắt không). Mỗi (lịch hẹn, mốc) được ghi ở nhac_lich_hen theo CHÍNH số giờ này']
  so_lich_hen_toi_da_moi_ho_so int [not null, note: 'Số lịch hẹn đang hoạt động tối đa của MỘT hồ sơ đi khám (bản thân hoặc từng hồ sơ người thân), KHÔNG phải mỗi tài khoản; >= 1; [cần điền]. Hồ sơ đi khám = (lich_hen.benh_nhan_id, lich_hen.ho_so_nguoi_than_id), NULL = bản thân; tập trạng thái "đang hoạt động" xem clinix_quy_tac_nghiep_vu.md']
  so_lan_tu_doi_lich_toi_da int [not null, note: '[cần điền]']
  check_in_truoc_phut int [not null, note: 'Số PHÚT trước giờ hẹn (lich_hen.thoi_gian) từ khi được tiếp đón (chuyển Đã tiếp đón); >= 0; [cần điền]. Cách hiểu cửa sổ tiếp đón là [đề xuất], xem clinix_quy_tac_nghiep_vu.md']
  check_in_sau_phut int [not null, note: 'Số PHÚT sau giờ hẹn vẫn còn được tiếp đón; >= 0; [cần điền]. KHÔNG phải thời điểm tự đánh Vắng mặt (tự Vắng mặt tính theo hết ca làm việc)']
  thoi_han_phan_hoi_loi_moi int [not null, default: 60, note: 'phút; [đề xuất] 60']
  so_muc_cho_toi_da int [not null, default: 2, note: '[đề xuất] 2']
  nguong_no_show int [not null, default: 3, note: '[đề xuất] 3 lần']
  so_ngay_bao_truoc_doi_gio_lam int [not null, note: 'Đơn vị: ngày (>= 0). Số ngày phải thông báo cho bệnh nhân bị ảnh hưởng TRƯỚC khi thay đổi ngày/giờ hoạt động hoặc dịch vụ khả dụng của chi nhánh có hiệu lực; tên cột giữ nguyên dù phạm vi gồm cả ngày hoạt động và dịch vụ khả dụng. Giá trị [cần điền]. Khi duyệt, giá trị được chụp vào yeu_cau_thay_doi_chi_nhanh.so_ngay_bao_truoc']
  trong_so_w1 decimal(3,2) [not null, note: '[cần điền]']
  trong_so_w2 decimal(3,2) [not null, note: '[cần điền]']

  Note: 'Bảng 1 dòng (id = 1) và KHÔNG có dòng nào được tạo sẵn: cột chưa có mặc định là [cần điền] và NOT NULL nên dòng chỉ tạo được khi nhóm đã chốt đủ giá trị (mẫu INSERT ở clinix_quy_tac_nghiep_vu.md mục 5); thiếu giá trị thì MySQL báo lỗi 1364, không có giá trị ngầm. Chưa có dòng thì dịch vụ từ chối các chức năng đọc cấu hình. Thời lượng khung giờ lấy theo dich_vu_kham.thoi_luong; không có giới hạn số ngày đặt trước cố định (đặt được tới ngày bác sĩ đã có khung giờ); không còn ghim ưu tiên bác sĩ. Sửa cấu hình phải ghi nhat_ky_hanh_dong (CapNhatCauHinh) trong cùng giao dịch. Giá trị hợp lệ: chk_cau_hinh_gia_tri (>= 0 hoặc > 0 theo từng cột, chưa có giới hạn trên [cần điền]).'
}

// ===================== CỤM 3: LỊCH LÀM VIỆC & KHUNG GIỜ =====================

Table lich_lam_viec {
  lich_lam_viec_id bigint [pk, increment]
  bac_si_id bigint [not null, ref: > bac_si.tai_khoan_id]
  chi_nhanh_id bigint [not null, ref: > chi_nhanh.chi_nhanh_id, note: 'Chi nhánh tại thời điểm phân công, giữ nguyên khi bác sĩ đổi chi nhánh']
  ngay date [not null]
  ca ca_lam_viec_enum [not null]

  indexes {
    (bac_si_id, ngay, ca) [unique]
    (chi_nhanh_id, ngay)
  }

  Note: 'Quy tắc service (DB không chặn): lich_lam_viec.chi_nhanh_id là chi nhánh tại thời điểm phân công. Chỉ phân công vào ngày chi nhánh có hoat_dong = true theo thứ của ngay VÀ ca phải có khoảng nhận khám tương ứng: CaSang cần khoảng sáng, CaChieu cần khoảng chiều; không phân công ca không tồn tại ở ngày đó (thao tác Cả ngày = CaSang + CaChieu chỉ hợp lệ khi cả hai khoảng tồn tại); không phân công vào ngày nghỉ hay chi nhánh chưa khai báo lịch hoạt động. Giờ của ca không có cột riêng: giờ ca là khoảng tương ứng của chi nhánh vào thứ đó [đề xuất]. CaToi vẫn còn trong enum nhưng lịch hoạt động không có khoảng tối nên không phân công được CaToi (nhóm quyết giữ hay bỏ khỏi enum: xem mục 8 của clinix_quy_tac_nghiep_vu.md).'
}

Table khung_gio {
  khung_gio_id bigint [pk, increment]
  lich_lam_viec_id bigint [not null, ref: > lich_lam_viec.lich_lam_viec_id]
  ngay_gio datetime [not null]
  trang_thai trang_thai_khung_gio_enum [not null, default: 'ConTrong']
  giu_cho_den datetime [note: 'Hạn giữ chỗ tạm; để trống khi không giữ']

  indexes {
    (lich_lam_viec_id, ngay_gio) [unique]
    (trang_thai, ngay_gio)
    (trang_thai, giu_cho_den)
  }

  Note: 'Khung giờ chỉ được sinh, hiển thị ConTrong và được giữ chỗ/đặt khi ngày của ngay_gio là ngày hoạt động của chi nhánh và [ngay_gio, ngay_gio + dich_vu_kham.thoi_luong] nằm TRỌN trong đúng một khoảng nhận khám của chi nhánh vào thứ đó, là khoảng ứng với ca của lich_lam_viec (CaSang: khoảng sáng; CaChieu: khoảng chiều). Không sinh khung giờ xuyên giờ nghỉ trưa hay kết thúc sau giờ kết thúc của khoảng. Các khung giờ trong cùng một khoảng nối liền nhau: khung đầu bắt đầu đúng giờ bắt đầu khoảng, mỗi khung dài đúng dich_vu_kham.thoi_luong, khung sau bắt đầu đúng lúc khung trước kết thúc (khoảng cách giữa các giờ bắt đầu = thời lượng khám); phần dư cuối khoảng không đủ một khung thì không sinh khung giờ (nhóm đồng ý 20/10/2026). Kiểm tra ở service (lúc sinh khung giờ, tính khung giờ trống, giữ chỗ/đặt lịch), DB không chặn.'
}

Table yeu_cau_nghi_phep {
  yeu_cau_nghi_phep_id bigint [pk, increment]
  bac_si_id bigint [not null, ref: > bac_si.tai_khoan_id]
  hinh_thuc_nghi hinh_thuc_nghi_enum [not null]
  ngay_bat_dau date [not null]
  ngay_ket_thuc date [not null]
  ca ca_lam_viec_enum [note: 'Bắt buộc khi nghỉ theo ca (TheoCa)']
  ly_do text [not null]
  trang_thai trang_thai_yeu_cau_enum [not null, default: 'ChoDuyet']
  nguoi_xu_ly_id bigint [ref: >? quan_tri_vien.tai_khoan_id]
  thoi_diem_xu_ly datetime [note: 'Ràng buộc: ChoDuyet thì người xử lý và thời điểm xử lý đều trống; DaDuyet hoặc TuChoi thì cả hai đều có']
  thoi_diem_tao datetime [not null]

  indexes {
    (bac_si_id, ngay_bat_dau, trang_thai)
  }

  Note: 'Ràng buộc theo hình thức nghỉ. CaNgay: không có ca, ngày bắt đầu <= ngày kết thúc (được nghỉ nhiều ngày). TheoCa: bắt buộc có ca, chỉ nghỉ 1 ngày.'
}

// ===================== CỤM 4: LỊCH HẸN & DANH SÁCH CHỜ =====================

Table lich_hen {
  lich_hen_id bigint [pk, increment]
  ma_lich_hen varchar(20) [not null, unique]
  khung_gio_id bigint [not null, ref: > khung_gio.khung_gio_id, note: 'KHÔNG unique: lịch đã hủy hoặc đã đổi vẫn giữ khung_gio_id để truy vết']
  khung_gio_dang_giu bigint [unique, note: 'Bằng khung_gio_id khi lịch còn hiệu lực (ChoThanhToan, DaXacNhan, DaTiepDon, HoanThanh, VangMat); NULL khi DaHuy hoặc DaDoiLich. Cột sinh STORED + UNIQUE: mỗi slot chỉ có 1 lịch còn hiệu lực.']
  lich_hen_truoc_id bigint [unique, ref: - lich_hen.lich_hen_id, note: 'Lịch cũ bị thay thế khi đổi lịch. UNIQUE: 1 lịch cũ chỉ sinh tối đa 1 lịch mới. Chỉ tạo lịch mới trong cùng giao dịch với việc chuyển lịch cũ sang DaDoiLich. Lịch không tự trỏ chính nó: kiểm tra ở service (không có CHECK vì MySQL cấm CHECK tham chiếu cột AUTO_INCREMENT). Chi tiết xem tài liệu quy tắc nghiệp vụ.']
  benh_nhan_id bigint [not null, ref: > benh_nhan.tai_khoan_id, note: 'Người đặt']
  ho_so_nguoi_than_id bigint [note: 'NULL = chính bệnh nhân đi khám (bản thân); có giá trị = hồ sơ người thân và PHẢI thuộc cùng benh_nhan_id (khóa ngoại kép (ho_so_nguoi_than_id, benh_nhan_id), DB chặn). Hồ sơ đi khám = (benh_nhan_id, ho_so_nguoi_than_id); khi đếm hoặc so sánh dùng <=> vì NULL = NULL không đúng']
  bac_si_id bigint [not null, ref: > bac_si.tai_khoan_id]
  chi_nhanh_id bigint [not null, ref: > chi_nhanh.chi_nhanh_id, note: 'Snapshot chi nhánh tại thời điểm đặt']
  dich_vu_kham_id bigint [not null, ref: > dich_vu_kham.dich_vu_kham_id, note: 'Snapshot dịch vụ tại thời điểm đặt']
  thoi_gian datetime [not null, note: 'Sao chép từ khung_gio.ngay_gio, không đổi']
  gia_snapshot decimal(12,2) [not null, note: 'Giá cuối = giá mặc định + phụ phí lúc đặt; lịch mới do đổi lịch sao chép từ lịch trước']
  tien_coc_snapshot decimal(12,2) [not null, default: 0, note: 'Lịch mới do đổi lịch sao chép từ lịch trước']
  chinh_sach_hoan_snapshot json [note: 'Bản sao các mốc hoàn tiền lúc đặt (chính sách không hồi tố); lịch mới do đổi lịch sao chép từ lịch trước']
  trang_thai trang_thai_lich_hen_enum [not null]
  han_thanh_toan datetime [note: 'Quá hạn mà chưa thanh toán thì tự hủy']
  thoi_diem_huy datetime
  ly_do_huy varchar(255)
  ly_do_kham text
  thoi_diem_tao datetime [not null, default: `now()`, note: 'Thời điểm đặt lịch']
  cap_nhat_lan_cuoi datetime [not null, default: `now()`, note: 'Tự cập nhật mỗi khi dòng thay đổi (ON UPDATE trong SQL)']

  indexes {
    (benh_nhan_id, trang_thai, thoi_gian)
    (bac_si_id, thoi_gian)
    (trang_thai, han_thanh_toan)
    (chi_nhanh_id, benh_nhan_id) [note: 'Quản trị viên Chi nhánh xem Bệnh nhân có lịch hẹn tại chi nhánh mình']
    (ho_so_nguoi_than_id, benh_nhan_id, trang_thai) [note: 'Đếm lịch hẹn đang hoạt động theo hồ sơ đi khám; đồng thời là chỉ mục của khóa ngoại kép tới ho_so_nguoi_than']
  }
}

Table yeu_cau_doi_lich_ngoai_chinh_sach {
  yeu_cau_doi_lich_ngoai_chinh_sach_id bigint [pk, increment]
  lich_hen_id bigint [not null, ref: > lich_hen.lich_hen_id]
  khung_gio_mong_muon_id bigint [not null, ref: > khung_gio.khung_gio_id]
  ly_do_yeu_cau text [not null, note: 'Lý do bệnh nhân cần đổi lịch']
  trang_thai trang_thai_yeu_cau_enum [not null, default: 'ChoDuyet']
  ghi_chu_xu_ly varchar(255) [note: 'Ghi chú của Lễ tân hoặc Quản trị viên khi duyệt hoặc từ chối']
  nguoi_xu_ly_id bigint [ref: >? tai_khoan.tai_khoan_id, note: 'Lễ tân hoặc Quản trị viên']
  thoi_diem_xu_ly datetime [note: 'Ràng buộc: ChoDuyet thì người xử lý và thời điểm xử lý đều trống; DaDuyet hoặc TuChoi thì cả hai đều có']
  thoi_diem_tao datetime [not null]

  indexes {
    (trang_thai, thoi_diem_tao)
  }

  Note: 'Ràng buộc: khi đã xử lý (khác ChoDuyet) thì bắt buộc có ghi_chu_xu_ly.'
}

Table ho_so_kham {
  ho_so_kham_id bigint [pk, increment]
  lich_hen_id bigint [not null, unique, ref: - lich_hen.lich_hen_id]
  trieu_chung text
  chan_doan_so_bo text
  huong_xu_ly text
  ngay_tai_kham_du_kien date
  cap_nhat_lan_cuoi datetime [not null]

  Note: 'Ghi hồ sơ khám là thao tác độc lập với xác nhận hoàn thành ca khám: bác sĩ ghi được khi lịch hẹn Đã tiếp đón hoặc sau khi Hoàn thành; KHÔNG bắt buộc đã có dòng ho_so_kham trước khi Hoàn thành (quyết định 17/10/2026). Khi bác sĩ lưu, các trường bắt buộc (triệu chứng, chẩn đoán sơ bộ, hướng xử lý) phải có nội dung (kiểm tra ở service; DB cho phép NULL). Chưa có hồ sơ thì giao diện bệnh nhân hiển thị "Chưa có hồ sơ khám", không tạo nội dung giả.'
}

Table muc_cho_danh_sach_cho {
  muc_cho_danh_sach_cho_id bigint [pk, increment]
  benh_nhan_id bigint [not null, ref: > benh_nhan.tai_khoan_id]
  bac_si_id bigint [not null, ref: > bac_si.tai_khoan_id]
  ngay_mong_muon date [not null]
  ca_mong_muon ca_lam_viec_enum [not null]
  thoi_diem_dang_ky datetime [not null, note: 'Dùng để xếp thứ hạng']
  trang_thai trang_thai_muc_cho_enum [not null, default: 'DangCho']
  khung_gio_duoc_moi_id bigint [ref: >? khung_gio.khung_gio_id, note: 'Slot đang giữ cho lời mời']
  khung_gio_dang_moi bigint [unique, note: 'Bằng khung_gio_duoc_moi_id khi trạng thái = DaMoi, còn lại NULL. Cột sinh STORED + UNIQUE: mỗi lúc chỉ 1 ứng viên cho 1 slot']
  thoi_han_phan_hoi datetime

  indexes {
    (bac_si_id, ngay_mong_muon, ca_mong_muon, trang_thai, thoi_diem_dang_ky)
    (trang_thai, thoi_han_phan_hoi)
    (benh_nhan_id, trang_thai)
  }

  Note: 'Không cho đăng ký trùng tiêu chí (bệnh nhân, bác sĩ, ngày, ca) khi còn DangCho hoặc DaMoi (kiểm tra ở service).'
}

// ===================== CỤM 5: THANH TOÁN & VÍ =====================

Table vi_noi_bo {
  vi_noi_bo_id bigint [pk, increment]
  benh_nhan_id bigint [not null, unique, ref: - benh_nhan.tai_khoan_id]
  so_du decimal(12,2) [not null, default: 0]
  so_tien_dang_giu decimal(12,2) [not null, default: 0, note: 'Tiền đang giữ cho yêu cầu rút chờ duyệt']

  Note: 'Ràng buộc: so_du >= 0, so_tien_dang_giu >= 0 và so_tien_dang_giu <= so_du. Số dư khả dụng = so_du - so_tien_dang_giu (tính khi đọc, không lưu). Ví được tạo cùng giao dịch với benh_nhan khi xác minh OTP đăng ký (so_du = 0, so_tien_dang_giu = 0); mỗi bệnh nhân đúng một ví.'
}

Table giao_dich_thanh_toan {
  giao_dich_thanh_toan_id bigint [pk, increment]
  vi_noi_bo_id bigint [ref: >? vi_noi_bo.vi_noi_bo_id, note: 'NapVi hoặc thanh toán bằng ví; để trống khi thu tiền mặt tại quầy']
  lich_hen_id bigint [ref: >? lich_hen.lich_hen_id, note: 'Chỉ có khi ThanhToanLichHen; trỏ LỊCH GỐC của chuỗi đổi lịch, không đổi khi đổi lịch']
  loai loai_giao_dich_enum [not null]
  phuong_thuc phuong_thuc_enum [not null]
  so_tien decimal(12,2) [not null]
  trang_thai trang_thai_giao_dich_enum [not null, default: 'KhoiTao']
  ma_giao_dich_cong varchar(100) [note: 'Mã cổng thanh toán trả về; chống xử lý trùng (idempotent)']
  trang_thai_doi_soat trang_thai_doi_soat_enum [not null, default: 'KhongCan']
  nguoi_thu_id bigint [ref: >? le_tan.tai_khoan_id, note: 'Lễ tân XÁC NHẬN ĐÃ NHẬN tiền mặt (không phải người tạo bản ghi, không phải người thanh toán). Bắt buộc khi phuong_thuc = TienMatTaiQuay, để trống với mọi phương thức khác (chk_gd_tien_mat_nguoi_thu). Khóa ngoại tới le_tan nên không thể là bác sĩ, bệnh nhân hay quản trị viên. Service lấy từ phiên đăng nhập của Lễ tân (không nhận từ giao diện) và kiểm tra Lễ tân thuộc chi nhánh của lịch hẹn lúc thu; DB không chặn chi nhánh']
  thoi_diem_tao datetime [not null]

  indexes {
    (phuong_thuc, ma_giao_dich_cong) [unique]
    (vi_noi_bo_id, thoi_diem_tao)
    (trang_thai, thoi_diem_tao)
    (trang_thai_doi_soat)
  }

  Note: 'Ràng buộc: NapVi thì lich_hen_id để trống và có vi_noi_bo_id; ThanhToanLichHen thì bắt buộc có lich_hen_id. Thu tiền mặt tại quầy (phuong_thuc = TienMatTaiQuay): chỉ ThanhToanLichHen, bắt buộc có lich_hen_id (lịch gốc) và nguoi_thu_id, không có vi_noi_bo_id và ma_giao_dich_cong, so_tien > 0, trang_thai = ThanhCong (dòng chỉ được tạo khi Lễ tân đã thu đủ phần còn lại; thu không thành công thì không tạo dòng); mọi phương thức khác thì nguoi_thu_id để trống (chk_gd_tien_mat_nguoi_thu). Một lịch hẹn có thể có nhiều dòng (khoản cọc và khoản thu còn lại) nên KHÔNG có UNIQUE theo lich_hen_id. Service chịu trách nhiệm: lấy nguoi_thu_id từ phiên đăng nhập, Lễ tân đúng chi nhánh của lịch hẹn, thu đủ đúng số còn phải thu, chống ghi trùng và ghi cùng giao dịch với việc chuyển DaTiepDon (xem clinix_quy_tac_nghiep_vu.md mục 2 dòng 45 đến 47).'
}

Table lich_su_hoan_tien {
  lich_su_hoan_tien_id bigint [pk, increment]
  giao_dich_thanh_toan_id bigint [not null, ref: > giao_dich_thanh_toan.giao_dich_thanh_toan_id, note: 'Khoản cọc được hoàn = giao dịch thanh toán của lịch gốc']
  vi_noi_bo_id bigint [not null, ref: > vi_noi_bo.vi_noi_bo_id, note: 'Tiền hoàn chỉ về ví, không hoàn tiền mặt']
  so_tien decimal(12,2) [not null]
  ly_do varchar(255)
  trang_thai ket_qua_enum [not null]
  so_lan_thu int [not null, default: 1, note: 'Mỗi dòng = 1 lần thử, kể cả thất bại']
  thoi_diem datetime [not null]

  indexes {
    (giao_dich_thanh_toan_id, so_lan_thu) [unique]
  }
}

Table yeu_cau_rut_tien {
  yeu_cau_rut_tien_id bigint [pk, increment]
  vi_noi_bo_id bigint [not null, ref: > vi_noi_bo.vi_noi_bo_id]
  so_tien decimal(12,2) [not null]
  trang_thai trang_thai_yeu_cau_enum [not null, default: 'ChoDuyet']
  nguoi_xu_ly_id bigint [ref: >? quan_tri_vien.tai_khoan_id]
  thoi_diem_yeu_cau datetime [not null]
  thoi_diem_xu_ly datetime [note: 'Ràng buộc: ChoDuyet thì người xử lý và thời điểm xử lý đều trống; DaDuyet hoặc TuChoi thì cả hai đều có']

  indexes {
    (trang_thai, thoi_diem_yeu_cau)
  }

  Note: 'Tạo yêu cầu: so_tien_dang_giu tăng so_tien. Duyệt: ghi giao_dich_vi loại Rut, so_du và so_tien_dang_giu cùng giảm so_tien. Từ chối: so_tien_dang_giu giảm so_tien.'
}

Table giao_dich_vi {
  giao_dich_vi_id bigint [pk, increment]
  vi_noi_bo_id bigint [not null, ref: > vi_noi_bo.vi_noi_bo_id]
  loai loai_giao_dich_vi_enum [not null]
  so_tien decimal(12,2) [not null, note: 'Có dấu: dương = tiền vào, âm = tiền ra']
  so_du_sau decimal(12,2) [not null]
  giao_dich_thanh_toan_id bigint [ref: >? giao_dich_thanh_toan.giao_dich_thanh_toan_id]
  lich_su_hoan_tien_id bigint [ref: >? lich_su_hoan_tien.lich_su_hoan_tien_id]
  yeu_cau_rut_tien_id bigint [ref: >? yeu_cau_rut_tien.yeu_cau_rut_tien_id]
  thoi_diem datetime [not null]

  indexes {
    (vi_noi_bo_id, thoi_diem)
  }

  Note: 'Sổ cái lịch sử nạp/trừ/hoàn/rút, chỉ thêm không sửa. Ràng buộc: đúng 1 trong 3 cột tham chiếu có giá trị, tùy theo loại.'
}

// ===================== CỤM 6: KHÁM & ĐÁNH GIÁ =====================

Table danh_gia_bac_si {
  danh_gia_bac_si_id bigint [pk, increment]
  lich_hen_id bigint [not null, unique, ref: - lich_hen.lich_hen_id, note: 'Tối đa 1 đánh giá cho mỗi lịch hẹn; bác sĩ và bệnh nhân suy ra qua lich_hen']
  so_sao tinyint [not null, note: 'Ràng buộc: 1 đến 5']
  nhan_xet text
  bi_an boolean [not null, default: false]
  ly_do_an varchar(255) [note: 'Bắt buộc khi bi_an = true; để trống khi bi_an = false. Người ẩn và thời điểm ẩn nằm trong nhat_ky_hanh_dong (AnDanhGia)']
  thoi_diem_tao datetime [not null]

  Note: 'Chỉ cho đánh giá khi lịch hẹn ở trạng thái HoanThanh (kiểm tra ở service). Ràng buộc: bi_an = false thì ly_do_an để trống; bi_an = true thì bắt buộc có ly_do_an.'
}

// ===================== CỤM 7: NỘI DUNG & VẬN HÀNH =====================

Table bai_viet {
  bai_viet_id bigint [pk, increment]
  tac_gia_id bigint [not null, ref: > quan_tri_vien.tai_khoan_id]
  tieu_de varchar(255) [not null]
  mo_ta_ngan varchar(500)
  noi_dung text [not null]
  anh_dai_dien varchar(255)
  trang_thai trang_thai_bai_viet_enum [not null, default: 'BanNhap']
  thoi_diem_xuat_ban datetime
  thoi_diem_tao datetime [not null, default: `now()`]
  cap_nhat_lan_cuoi datetime [not null, default: `now()`, note: 'Tự cập nhật mỗi khi dòng thay đổi (ON UPDATE trong SQL)']
}

Table hashtag {
  hashtag_id bigint [pk, increment]
  ten varchar(50) [not null, unique, note: 'Chuẩn hóa chữ thường']
  trang_thai_hoat_dong boolean [not null, default: true]
}

Table bai_viet_hashtag {
  bai_viet_id bigint [ref: > bai_viet.bai_viet_id]
  hashtag_id bigint [ref: > hashtag.hashtag_id]

  indexes {
    (bai_viet_id, hashtag_id) [pk]
    (hashtag_id, bai_viet_id)
  }
}

Table benh_nhan_danh_gia_bai_viet {
  benh_nhan_id bigint [ref: > benh_nhan.tai_khoan_id]
  bai_viet_id bigint [ref: > bai_viet.bai_viet_id]
  loai loai_cam_xuc_enum [not null]

  indexes {
    (benh_nhan_id, bai_viet_id) [pk]
    (bai_viet_id, loai)
  }
}

Table thong_bao {
  thong_bao_id bigint [pk, increment]
  tai_khoan_id bigint [not null, ref: > tai_khoan.tai_khoan_id]
  noi_dung varchar(500) [not null]
  loai_su_kien varchar(100) [not null, note: 'Mã sự kiện nghiệp vụ. Sự kiện báo bệnh nhân về thay đổi chi nhánh sắp có hiệu lực: [đề xuất] ThayDoiChiNhanhAnhHuongLichHen; kết quả cho người đề xuất: [đề xuất] KetQuaYeuCauThayDoiChiNhanh. Chưa có danh mục mã sự kiện chung']
  trang_thai_doc boolean [not null, default: false]
  yeu_cau_thay_doi_chi_nhanh_id bigint [ref: >? yeu_cau_thay_doi_chi_nhanh.yeu_cau_thay_doi_chi_nhanh_id, note: 'Chỉ có với thông báo sinh từ yêu cầu thay đổi chi nhánh; các thông báo khác để trống. Cùng (yêu cầu, tài khoản, loại sự kiện) chỉ có 1 thông báo nên duyệt lại/chạy lại không tạo thông báo trùng']
  thoi_diem_tao datetime [not null]

  indexes {
    (tai_khoan_id, trang_thai_doc, thoi_diem_tao)
    (yeu_cau_thay_doi_chi_nhanh_id, tai_khoan_id, loai_su_kien) [unique]
  }

  Note: 'Thông báo trong ứng dụng (kênh thứ nhất). "Đẩy tức thời" là cách giao diện hiển thị ngay thông báo này cho phiên đang mở; không phải thông báo đẩy trên thiết bị di động và CSDL không có bảng token thiết bị. Email của thông báo nằm ở email_thong_bao.'
}

Table email_thong_bao {
  email_thong_bao_id bigint [pk, increment]
  thong_bao_id bigint [not null, unique, ref: - thong_bao.thong_bao_id, note: 'UNIQUE: mỗi thông báo có đúng 1 dòng email; gửi lại cập nhật chính dòng này, không tạo dòng mới']
  trang_thai trang_thai_gui_email_enum [not null, default: 'ChoGui']
  so_lan_thu int [not null, default: 0, note: 'Số lần đã thử gửi, tăng khi nhận việc gửi']
  lan_thu_cuoi_luc datetime
  da_gui_luc datetime [note: 'Chỉ có khi DaGui']
  loi_cuoi varchar(500) [note: 'Bắt buộc khi ThatBai: lỗi của Dịch vụ Email ở lần thử cuối']
  thoi_diem_tao datetime [not null, default: `now()`]

  indexes {
    (trang_thai, lan_thu_cuoi_luc)
  }

  Note: 'Ghi nhận và gửi lại email của thông báo sự kiện (use case Gửi email thông báo theo sự kiện). Email lỗi chỉ đổi dòng này sang ThatBai, KHÔNG xóa thông báo trong ứng dụng và KHÔNG hoàn tác nghiệp vụ đã duyệt. Không gửi trùng: DaGui là trạng thái cuối; mỗi lần nhận việc là 1 UPDATE có điều kiện (trang_thai khác DaGui và so_lan_thu còn đúng giá trị đã đọc), chỉ worker có ROW_COUNT = 1 được gửi. Số lần thử lại tối đa và khoảng cách [cần điền] ([đề xuất] như nhắc lịch: 3 lần, cách 5 phút). Email nhắc lịch hẹn (2.4.69) không có thong_bao đi kèm nên KHÔNG đi qua bảng này mà ghi ở nhac_lich_hen.'
}

Table nhac_lich_hen {
  lich_hen_id bigint [not null, ref: > lich_hen.lich_hen_id]
  so_gio_truoc int [not null, note: 'Mốc nhắc = số giờ trước giờ hẹn, là CHÍNH một phần tử của cau_hinh_he_thong.thoi_diem_nhac_lich tại lúc tạo dòng (không phải vị trí trong mảng nên đổi mảng không làm lệch lịch sử); >= 1 (chk_nhac_lich_hen_moc)']
  trang_thai trang_thai_gui_email_enum [not null, default: 'ChoGui']
  so_lan_thu int [not null, default: 0, note: 'Số lần đã thử gửi, tăng khi nhận việc gửi']
  lan_thu_cuoi_luc datetime
  da_gui_luc datetime [note: 'Chỉ có khi DaGui']
  loi_cuoi varchar(500) [note: 'Bắt buộc khi ThatBai: lỗi của Dịch vụ Email ở lần thử cuối']
  thoi_diem_tao datetime [not null, default: `now()`]

  indexes {
    (lich_hen_id, so_gio_truoc) [pk, note: 'Mỗi cặp (lịch hẹn, mốc) tối đa 1 dòng => không gửi trùng một mốc']
    (trang_thai, lan_thu_cuoi_luc)
  }

  Note: 'Ghi nhận việc gửi email nhắc lịch hẹn theo từng mốc (use case Gửi nhắc lịch hẹn theo lịch trình). Nhắc lịch chỉ qua email, không có thong_bao đi kèm nên không dùng email_thong_bao. Dòng chỉ được tạo khi mốc đến hạn (INSERT ... ON DUPLICATE KEY UPDATE lich_hen_id = lich_hen_id; ROW_COUNT 1 = vừa tạo). Nhận việc gửi bằng UPDATE có điều kiện (trang_thai khác DaGui và so_lan_thu còn đúng giá trị đã đọc), chỉ worker có ROW_COUNT = 1 được gửi. Thử lại theo 2.4.69 (3 lần, cách 5 phút, chỉ khi lịch hẹn còn DaXacNhan và chưa tới giờ hẹn) là hằng số của service, KHÔNG có cột cấu hình; hết lần thì giữ ThatBai, không gửi bù mốc khác. Lịch hẹn đổi giờ tạo lich_hen mới nên tự có bộ mốc mới. Chưa chốt [cần điền]: lần gửi đầu có tính vào số lần thử lại không; cho phép trễ tối đa bao lâu sau khi đạt mốc.'
}

Table hoi_thoai {
  hoi_thoai_id bigint [pk, increment]
  loai loai_hoi_thoai_enum [not null]
  chi_nhanh_id bigint [ref: >? chi_nhanh.chi_nhanh_id, note: 'BenhNhan_LeTan: bắt buộc (hộp thư chung chi nhánh); BenhNhan_BacSi: để trống']
  nguoi_tao_id bigint [not null, ref: > tai_khoan.tai_khoan_id]
  thoi_diem_tao datetime [not null]

  indexes {
    (chi_nhanh_id, loai, thoi_diem_tao)
  }

  Note: 'Ràng buộc: BenhNhan_LeTan thì bắt buộc có chi_nhanh_id; BenhNhan_BacSi thì để trống. Hội thoại không có trạng thái đóng.'
}

Table tai_khoan_hoi_thoai {
  tai_khoan_id bigint [ref: > tai_khoan.tai_khoan_id]
  hoi_thoai_id bigint [ref: > hoi_thoai.hoi_thoai_id]
  tin_nhan_cuoi_da_doc_id bigint [ref: >? tin_nhan.tin_nhan_id, note: 'Tin mới nhất người này đã đọc; để trống = chưa đọc gì']

  indexes {
    (tai_khoan_id, hoi_thoai_id) [pk]
    (hoi_thoai_id, tai_khoan_id)
  }

  Note: 'Tin chưa đọc = tin có tin_nhan_id lớn hơn mốc đã đọc (hoặc tất cả nếu để trống) và người gửi khác chính mình. Mốc phải thuộc cùng hội thoại (kiểm tra ở service). Hộp thư chung Lễ tân: mỗi Lễ tân có dòng riêng, tạo khi mở hoặc trả lời hội thoại lần đầu; chưa có dòng thì coi như chưa đọc.'
}

Table tin_nhan {
  tin_nhan_id bigint [pk, increment]
  hoi_thoai_id bigint [not null, ref: > hoi_thoai.hoi_thoai_id]
  nguoi_gui_id bigint [not null, ref: > tai_khoan.tai_khoan_id]
  noi_dung text [not null]
  tep_dinh_kem varchar(255)
  thoi_diem_gui datetime [not null]

  indexes {
    (hoi_thoai_id, tin_nhan_id)
  }
}

Table nhat_ky_hanh_dong {
  nhat_ky_hanh_dong_id bigint [pk, increment]
  tai_khoan_id bigint [not null, ref: > tai_khoan.tai_khoan_id, note: 'Người thực hiện']
  chi_nhanh_id bigint [ref: >? chi_nhanh.chi_nhanh_id, note: 'Chi nhánh liên quan, để Quản trị viên phạm vi Chi nhánh lọc nhật ký']
  hanh_dong hanh_dong_nhay_cam_enum [not null]
  loai_doi_tuong loai_doi_tuong_enum [not null, note: 'Bảng bị tác động']
  ma_doi_tuong bigint [not null, note: 'Khóa chính của bản ghi bị tác động; không có FK để nhật ký còn nguyên khi bản ghi gốc bị xóa hoặc ẩn']
  thoi_diem datetime [not null]
  ket_qua ket_qua_enum [not null]
  chi_tiet_thay_doi json [note: 'Nội dung trước và sau khi thay đổi. Với hanh_dong = CapNhatCauHinh BẮT BUỘC có dạng {"truoc":{<tham số>:<giá trị cũ>},"sau":{<cùng tập tham số>:<giá trị mới>},"ly_do":"..."}: truoc và sau cùng tập khóa (chỉ tham số có đổi, ít nhất 1), ly_do là chuỗi không rỗng [đề xuất: bắt buộc]; lần tạo dòng cấu hình đầu tiên ghi truoc = null cho từng tham số (chk_nhat_ky_cap_nhat_cau_hinh)']

  indexes {
    (loai_doi_tuong, ma_doi_tuong, thoi_diem)
    (tai_khoan_id, thoi_diem)
    (chi_nhanh_id, thoi_diem)
  }

  Note: 'CapNhatCauHinh: loai_doi_tuong = cau_hinh_he_thong, ma_doi_tuong = 1, chi_nhanh_id để trống; ghi cùng giao dịch với việc sửa cấu hình (DB không tự ép: không dùng trigger, service chịu trách nhiệm). XuLyNapViChuaCong: loai_doi_tuong = giao_dich_thanh_toan, ma_doi_tuong = giao_dich_thanh_toan_id; ghi cùng giao dịch với thao tác cộng ví và đánh dấu đã đối soát (UC 53/70). Giới hạn quyền Admin theo UC 53, DB không tự kiểm tra vai trò.'
}

// Khóa ngoại kép: hồ sơ người thân của lịch hẹn phải thuộc đúng bệnh nhân đặt lịch. ho_so_nguoi_than_id NULL (bản thân) thì MySQL không kiểm tra cặp này
Ref: lich_hen.(ho_so_nguoi_than_id, benh_nhan_id) > ho_so_nguoi_than.(ho_so_nguoi_than_id, benh_nhan_id)
